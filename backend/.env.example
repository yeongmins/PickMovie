# backend/.env.example
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pickmovie_db?schema=public"

TMDB_API_KEY=your_tmdb_api_key
KOBIS_API_KEY=your_kobis_api_key
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m

# 관리자 보호(필수)
ADMIN_TOKEN=replace_with_long_random_admin_token

# CORS (여러개면 콤마로)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# proxy 뒤면 켜기
TRUST_PROXY=0

# mail (SMTP)
# production에서는 MAIL_REQUIRED=true 권장 (기본: production=true, development=false)
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=15000
MAIL_REQUIRED=false

# 요청 제한(기본값: 60초당 120회)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# home charts cron
HOME_CHARTS_CRON_ENABLED=true
HOME_CHARTS_CRON="5 */6 * * *"
HOME_CHARTS_TZ="Asia/Seoul"
HOME_CHARTS_LIMIT=20
